on init
    # Bind mount vendor overlay
    mount none /vendor/lost+found /vendor/overlay bind

    # IMS / VoLTE overrides
    setprop sys.usb.ffs.aio_compat 1
    setprop persist.dbg.allow_ims_off 1
    setprop persist.dbg.volte_avail_ovr 1
    setprop persist.dbg.vt_avail_ovr 1
    setprop persist.dbg.wfc_avail_ovr 1
    setprop persist.vendor.vilte_support 1

    # Override vendor fstab before first stage mount
    mount none /system/etc/fstab.mt6833 /vendor/etc/fstab.mt6833 bind

on post-fs
    # Unmount the overridden fstab — partitions are already mounted,
    # reverting prevents MTK daemons from crashing due to wrong SELinux label
    umount /vendor/etc/fstab.mt6833

# Disable AOSP RIL if MTK RIL is up
on property:vendor.ril.mtk=1
    stop vendor.ril-daemon
